{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/Fundo.Applications.WebApi/bin/Debug/net10.0/Fundo.Applications.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/Fundo.Applications.WebApi",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend (Angular)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "serve-frontend",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": ["Backend (.NET)", "Frontend (Angular)"]
    }
  ]
}
